{
  "name": "loon",
  "version": "2.0.0-dev",
  "description": "LOON: a free-tier, serverless micro-CMS on Cloudflare Pages, D1 and GitHub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/check.mjs",
    "validate": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "miniflare": "4.20260730.0",
    "vitest": "3.2.7",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenSweaterVest/LOON.git"
  },
  "license": "MIT"
}
