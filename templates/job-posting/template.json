{
  "title": "Job Posting",
  "description": "Create or update a job listing",
  "schema": {
    "fields": [
      {
        "key": "title",
        "label": "Job Title",
        "type": "text",
        "required": true,
        "placeholder": "Senior Software Engineer"
      },
      {
        "key": "department",
        "label": "Department",
        "type": "text",
        "placeholder": "Engineering"
      },
      {
        "key": "location",
        "label": "Location",
        "type": "text",
        "placeholder": "Minneapolis, MN (Hybrid)"
      },
      {
        "key": "type",
        "label": "Employment Type",
        "type": "select",
        "options": [
          "Full-time",
          "Part-time",
          "Contract",
          "Internship"
        ]
      },
      {
        "key": "salary_range",
        "label": "Salary Range",
        "type": "text",
        "placeholder": "$80,000 - $120,000"
      },
      {
        "key": "description",
        "label": "Job Description",
        "type": "markdown",
        "required": true,
        "placeholder": "Describe the role and responsibilities...",
        "rows": 6
      },
      {
        "key": "requirements",
        "label": "Requirements",
        "type": "markdown",
        "placeholder": "List qualifications and requirements...",
        "rows": 4
      },
      {
        "key": "benefits",
        "label": "Benefits",
        "type": "markdown",
        "placeholder": "List benefits and perks..."
      },
      {
        "key": "apply_url",
        "label": "Application Link",
        "type": "url",
        "placeholder": "https://..."
      },
      {
        "key": "contact_email",
        "label": "Contact Email",
        "type": "email",
        "placeholder": "jobs@company.com"
      },
      {
        "key": "status",
        "label": "Posting Status",
        "type": "select",
        "options": [
          "Open",
          "Closed",
          "On Hold",
          "Filled"
        ]
      },
      {
        "key": "remote",
        "label": "Remote Friendly",
        "type": "checkbox"
      }
    ]
  },
  "sample": {
    "title": "Senior Software Engineer",
    "department": "Engineering",
    "location": "Minneapolis, MN (Hybrid)",
    "type": "Full-time",
    "salary_range": "$95,000 - $130,000",
    "description": "We're looking for an experienced software engineer to join our growing team. You'll work on building and maintaining our core platform, collaborating with cross-functional teams, and mentoring junior developers.\n\nThis role offers the opportunity to work on challenging problems with a talented team in a supportive environment.",
    "requirements": "- 5+ years of software development experience\n- Proficiency in JavaScript/TypeScript and Python\n- Experience with cloud platforms (AWS, GCP, or Azure)\n- Strong communication skills\n- Bachelor's degree in CS or equivalent experience",
    "benefits": "- Competitive salary and equity\n- Health, dental, and vision insurance\n- 401(k) with company match\n- Flexible PTO\n- Professional development budget",
    "apply_url": "",
    "contact_email": "jobs@company.com",
    "status": "Open",
    "remote": true
  }
}
