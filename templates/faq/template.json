{
  "title": "FAQ",
  "description": "Frequently asked questions with expandable answers.",
  "schema": {
    "fields": [
      {
        "key": "title",
        "label": "Title",
        "type": "text",
        "required": true
      },
      {
        "key": "summary",
        "label": "Introduction",
        "type": "textarea",
        "rows": 2
      },
      {
        "key": "questions",
        "label": "Questions",
        "type": "repeater",
        "itemLabel": "Question",
